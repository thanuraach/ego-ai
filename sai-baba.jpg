e\":{\"enable_endpoint_origins\":true,\"force_hashed_domains\":[\"www.coinbase.com\"],\"allowed_subdomains\":[]},\"is_device_based\":false,\"passed\":true},\"1717390098\":{\"name\":\"1717390098\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"2898025270\",\"gateValue\":\"false\",\"ruleID\":\"7342L0RKNFaahun8rgEWIe\"}],\"version\":15,\"id_type\":\"userID\",\"value\":{\"work\":false,\"chat\":false},\"is_device_based\":false,\"passed\":false},\"1977158438\":{\"name\":\"1977158438\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":5,\"id_type\":\"userID\",\"value\":{\"system_prompt\":\"The user is asking about an ad shown to them by {advertiser}. Your response must be about the ad shown. They are using the \\\"Ask ChatGPT\\\" feature to get ChatGPT's honest opinion on the product(s) in the advertisement, and in which situations it could be a great fit for them. You should be honest about when you think the product(s) would vs. would not be useful for the user, based on what you know about them.\\n\\nInformation about the ad:\\n{ad}.\\n\\nStructure your response in the following manner:\\n- Briefly describe the type of user, use case, or situation where this ad/product makes sense for the user.\\n- If appropriate, explain any mismatches with the user's stated preferences or goals. That is, where might it fall short for the user (if appropriate)? You don't have to do this for every query, but feel free to list limitations if you think they're pretty relevant.\\n- Give a concise recommendation (e.g., \\\"worth considering,\\\" \\\"probably not ideal,\\\" \\\"good budget option,\\\" \\\"seriously may be a fit,\\\" etc.)\\n\\nGuidelines:\\n- Be honest and practical.\\n- Do not blindly promote the ad.\\n- Avoid harsh or absolute negative language.\\n- Do not invent details not present in the ad.\\n- Focus on fit, not feature lists.\\n- If the mark on relevance is clearly missed, feel free to be funny with it and keep it lighthearted. Do not mock the user or advertiser; keep the humor gentle.\\n\\nKeep it concise, direct, and easy to scan.\\n\\n{conversation}\",\"user_prompt_key\":\"good_option\",\"enable_web_search\":false},\"is_device_based\":false,\"passed\":false},\"2048788910\":{\"name\":\"2048788910\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":7,\"id_type\":\"userID\",\"value\":{\"enabled\":3,\"intervalMs\":200},\"is_device_based\":false,\"passed\":false},\"1504865540\":{\"name\":\"1504865540\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":10,\"id_type\":\"userID\",\"value\":{\"max_file_size_mb\":25},\"is_device_based\":false,\"passed\":false},\"3333071866\":{\"name\":\"3333071866\",\"rule_id\":\"launchedGroup\",\"secondary_exposures\":[],\"version\":92,\"id_type\":\"userID\",\"value\":{\"enabled\":true},\"is_device_based\":false,\"group_name\":\"Test\",\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"2055363467\":{\"name\":\"2055363467\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":29,\"id_type\":\"userID\",\"value\":{\"max_notification_rules_per_scan\":10,\"should_send\":true,\"max_receivers_per_rule\":5,\"can_configure\":true},\"is_device_based\":false,\"passed\":false},\"383746455\":{\"name\":\"383746455\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":12,\"id_type\":\"userID\",\"value\":{\"disable_local_indexing\":false,\"local_result_limit\":5,\"disable_image_thumbnails\":false,\"disable_hover_previews\":false},\"is_device_based\":false,\"passed\":false},\"1638994742\":{\"name\":\"1638994742\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":21,\"id_type\":\"userID\",\"value\":{\"web_disabled_file_previewer_types\":[]},\"is_device_based\":false,\"passed\":false},\"463092697\":{\"name\":\"463092697\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"4113286138\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"251005210\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\