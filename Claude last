<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#ffffff">
<title>Ego AIII</title>
<style>
:root{--ink:#10203F;--mute:#5B6B8C;--line:#E1E9F7;--soft:#F5F9FF;--blue:#1F5BFF;--blue2:#0E3FD0;--green:#12B76A;--coral:#E5484D;--amber:#E8A317;--r:20px}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;max-width:100%;overflow-x:hidden}
body{font:16px/1.5 -apple-system,"SF Pro Text",system-ui,sans-serif;color:var(--ink);background:#fff;padding-bottom:calc(84px + env(safe-area-inset-bottom))}
.wrap{max-width:1040px;margin:0 auto;padding:0 16px}
header{position:sticky;top:0;z-index:20;background:rgba(255,255,255,.8);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-bottom:1px solid var(--line);padding-top:env(safe-area-inset-top)}
header .wrap{display:flex;align-items:center;justify-content:space-between;height:84px}
.brand{display:flex;align-items:center;gap:12px}
.mark{width:40px;height:40px}
.name{font-size:22px;font-weight:750;letter-spacing:-.02em;color:var(--blue2)}
.name small{display:block;font-size:12px;font-weight:500;color:var(--mute);letter-spacing:0}
.arch{width:56px;height:72px;border-radius:28px 28px 12px 12px;overflow:hidden;position:relative;background:linear-gradient(160deg,#EAF2FF,#E4FAEF);border:1px solid var(--line);box-shadow:0 6px 20px rgba(31,91,255,.14);flex:none}
.arch svg{position:absolute;inset:0;margin:auto;width:60%;opacity:.55}
.arch img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.92}
main{padding:18px 0}
.hero{border-radius:26px;padding:20px;background:linear-gradient(135deg,#F0F6FF 0%,#E9FBF2 100%);border:1px solid var(--line)}
.hero h1{margin:0 0 4px;font-size:24px;line-height:1.25;letter-spacing:-.02em}
.hero p{margin:0;color:var(--mute)}
.row{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
.chip{display:inline-flex;align-items:center;gap:7px;padding:7px 12px;border-radius:999px;background:#fff;border:1px solid var(--line);font-size:14px}
.dot{width:9px;height:9px;border-radius:50%;background:#B9C4DA}
.dot.on{background:var(--green);box-shadow:0 0 0 0 rgba(18,183,106,.5);animation:pulse 2s infinite}
@keyframes pulse{70%{box-shadow:0 0 0 9px rgba(18,183,106,0)}100%{box-shadow:0 0 0 0 rgba(18,183,106,0)}}
.lang button{border:0;background:none;font:inherit;font-size:14px;color:var(--mute);padding:4px 8px;border-radius:10px}
.lang button.a{background:var(--blue);color:#fff}
.card{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:16px;margin-top:14px;box-shadow:0 8px 28px rgba(31,91,255,.06)}
.card h2{margin:0 0 10px;font-size:17px}
.g{display:grid;gap:14px}
@media(min-width:760px){.g2{grid-template-columns:1fr 1fr}.g3{grid-template-columns:repeat(3,1fr)}}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.stat{background:var(--soft);border-radius:16px;padding:12px}
.stat b{display:block;font-size:20px;letter-spacing:-.02em}
.stat span{font-size:13px;color:var(--mute)}
.li{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:11px 0;border-top:1px solid var(--line)}
.li:first-of-type{border-top:0}
.li small{display:block;color:var(--mute);font-size:13px}
.pill{padding:3px 10px;border-radius:999px;font-size:13px;font-weight:650;white-space:nowrap}
.LONG{background:#E3F8EE;color:#0B7A47}.SHORT{background:#FDEBEC;color:#B4232A}.WAIT{background:#EEF2F9;color:#4A5873}
.tag{background:#FFF4DC;color:#8A5A00}
.warn{font-size:13px;color:var(--mute);margin-top:10px}
.demo{margin-top:14px;padding:10px 14px;border-radius:14px;background:#FFF4DC;color:#7A5200;font-size:14px}
.err{margin-top:14px;padding:10px 14px;border-radius:14px;background:#FDEBEC;color:#B4232A;font-size:14px;word-break:break-word}
.sk{height:64px;border-radius:16px;background:linear-gradient(90deg,#EEF3FB 25%,#F8FAFE 50%,#EEF3FB 75%);background-size:200% 100%;animation:sh 1.4s infinite;margin-top:12px}
@keyframes sh{to{background-position:-200% 0}}
.msgs{display:flex;flex-direction:column;gap:10px;min-height:180px;max-height:46vh;overflow:auto;padding:4px}
.b{max-width:86%;padding:10px 14px;border-radius:18px;white-space:pre-wrap;word-break:break-word}
.b.u{align-self:flex-end;background:var(--blue);color:#fff;border-bottom-right-radius:6px}
.b.a{align-self:flex-start;background:var(--soft);border:1px solid var(--line);border-bottom-left-radius:6px}
.ty span{display:inline-block;width:7px;height:7px;margin:0 2px;border-radius:50%;background:var(--blue);animation:bn 1s infinite}
.ty span:nth-child(2){animation-delay:.15s;background:#2A8FD8}.ty span:nth-child(3){animation-delay:.3s;background:var(--green)}
@keyframes bn{50%{transform:translateY(-5px);opacity:.5}}
.inp{display:flex;gap:8px;margin-top:10px}
input[type=text],input[type=password],input[type=url]{width:100%;font:inherit;padding:13px 14px;border-radius:14px;border:1px solid var(--line);background:#fff;color:var(--ink);min-height:48px}
input:focus{outline:2px solid var(--blue);outline-offset:1px}
.btn{font:inherit;font-weight:650;border:0;border-radius:14px;padding:12px 18px;min-height:48px;background:linear-gradient(135deg,var(--blue),#1A86E0 60%,var(--green));color:#fff}
.btn.o{background:#fff;color:var(--blue2);border:1px solid var(--line)}
.q{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}
.q button{font:inherit;font-size:14px;background:var(--soft);border:1px solid var(--line);border-radius:999px;padding:8px 12px;color:var(--ink);min-height:40px}
label{display:block;font-size:14px;color:var(--mute);margin:12px 0 5px}
.tool{display:flex;gap:12px;align-items:center}
.tool i{width:42px;height:42px;border-radius:14px;display:grid;place-items:center;background:var(--soft);flex:none}
.tool svg{width:22px;height:22px;stroke:var(--blue);fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.st{margin-left:auto;font-size:12px;font-weight:650;padding:3px 9px;border-radius:999px;white-space:nowrap}
.st.live{background:#E3F8EE;color:#0B7A47}.st.needs{background:#FFF4DC;color:#8A5A00}.st.nb{background:#EEF2F9;color:#4A5873}
nav{position:fixed;left:0;right:0;bottom:0;z-index:30;display:flex;background:rgba(255,255,255,.9);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-top:1px solid var(--line);padding:6px 6px calc(6px + env(safe-area-inset-bottom))}
nav button{flex:1;border:0;background:none;font:inherit;font-size:12px;color:var(--mute);display:flex;flex-direction:column;align-items:center;gap:3px;padding:6px 2px;min-height:56px;border-radius:14px}
nav button svg{width:24px;height:24px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
nav button.a{color:var(--blue);background:var(--soft);font-weight:650}
@media(min-width:900px){body{padding-bottom:0;padding-left:210px}
nav{right:auto;top:0;width:210px;flex-direction:column;justify-content:flex-start;padding:100px 12px 12px;border-top:0;border-right:1px solid var(--line);gap:4px}
nav button{flex:none;flex-direction:row;gap:12px;font-size:15px;padding:12px 14px;justify-content:flex-start;min-height:48px}
header{position:fixed;left:210px;right:0;top:0}main{padding-top:104px}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<header><div class="wrap">
 <div class="brand">
  <svg class="mark" viewBox="0 0 40 40" aria-hidden="true"><defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#1F5BFF"/><stop offset="1" stop-color="#12B76A"/></linearGradient></defs><circle cx="20" cy="20" r="16" fill="none" stroke="url(#g)" stroke-width="5"/><circle cx="20" cy="20" r="5.5" fill="url(#g)"/></svg>
  <div class="name">Ego AIII<small id="tag"></small></div>
 </div>
 <div class="arch" aria-label="Portrait">
  <svg viewBox="0 0 24 24" fill="none" stroke="#1F5BFF" stroke-width="1.2" stroke-linecap="round"><path d="M12 5c1.5 2 1.5 5 0 7-1.5-2-1.5-5 0-7zM12 12c-3-.5-5-2.5-5.5-5 2.5.2 4.500 1.200 5.500 3M12 12c3-.5 5-2.5 5.500-5-2.500.2-4.500 1.200-5.500 3M7 14c2 0 4 1 5 3 1-2 3-3 5-3M5 17c2.500.5 5 2 7 4 2-2 4.500-3.500 7-4"/></svg>
  <!-- Place your own portrait file named sai-baba.jpg next to this page. If missing, the lotus shows. -->
  <img src="sai-baba.jpg" alt="" onerror="this.remove()">
 </div>
</div></header>
<main><div class="wrap" id="app"></div></main>
<nav id="nav"></nav>
<script>
const T={
en:{home:'Home',trade:'Trading',chat:'Chat',tools:'Tools',settings:'Settings',tag:'Calm, careful market intelligence',hello:'Welcome to Ego AIII',sub:'Your calm, careful market assistant.',aiOn:'AI engine live',aiOff:'AI engine not connected',auto:'Automation',on:'On',off:'Off',lastScan:'Last scan',paper:'Paper trading',equity:'Virtual balance',ret:'Return',win:'Win rate',open:'Open paper trades',topShort:'Top SHORT candidates',topLong:'Top LONG candidates',waitN:'coins on WAIT',none:'Nothing right now. WAIT is a valid answer.',sig:'Signal history',entry:'Entry',sl:'Stop-loss',exp:'Expires',dis:'DISAGREEMENT',agree:'Agreement',ph:'Ask Ego AIII anything…',send:'Send',recent:'Recent questions',quick:'Quick starts',q1:'Explain RSI in simple words',q2:'What does DISAGREEMENT mean?',q3:'Explain risk per trade',needChat:'Chat is not connected yet. It needs the ai-chat backend function, which is not deployed.',tl:'AI tools',live:'Live',needs:'Needs backend',nb:'Not built yet',tChat:'AI chat',tSmart:'Smart answers',tImg:'Image generation',tDoc:'Document analysis',tCode:'Code assistant',tTrade:'Trading analysis',url:'Supabase project URL',anon:'Public API key (anon or publishable)',pin:'Dashboard PIN',save:'Save',test:'Test connection',lang:'Language',chatOn:'My ai-chat function is deployed',demo:'DEMO: sample data, not real. Add your connection in Settings.',warn:'Paper results only. Not financial advice.',err:'Could not load data:',ok:'Connected',saved:'Saved'}
};
const IC={home:'<path d="M3 11l9-8 9 8v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>',trade:'<path d="M3 17l5-5 4 4 8-9M15 7h5v5"/>',chat:'<path d="M21 12a8 8 0 0 1-11.600 7.100L4 20l1-4.500A8 8 0 1 1 21 12z"/>',tools:'<rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/>',settings:'<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2"/>'};
const $=s=>document.querySelector(s);
const esc=s=>String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function ls(k,d){try{const v=localStorage.getItem('ego_'+k);return v?JSON.parse(v):d}catch(e){return d}}
function sv(k,v){try{localStorage.setItem('ego_'+k,JSON.stringify(v))}catch(e){}}
const S={lang:'en',tab:'home',cfg:ls('cfg',{}),data:null,err:null,loading:true,demo:false,chat:ls('chat',[]),typing:false,msg:''};
const t=k=>(T[S.lang][k]!=null?T[S.lang][k]:T.en[k]||k);
const fp=n=>{if(n==null||n==='')return'–';n=Number(n);return n>=100?n.toFixed(2):n>=1?n.toFixed(4):n.toPrecision(4)};
const ago=i=>{if(!i)return'–';const m=Math.round((Date.now()-new Date(i))/60000);return m<1?'<1 min':m<90?m+' min':Math.round(m/60)+' h'};
const ago2=i=>{if(!i)return'–';const m=Math.round((new Date(i)-Date.now())/60000);return m<=0?'expired':m+' min'};
const now=Date.now();
const DEMO={status:{automation_enabled:true,last_scan:new Date(now-12*6e4).toISOString()},
scan:[{symbol:'SAMPLE1USDT',rule_decision:'SHORT',short_score:5,long_score:0,adx:25,price:0.2171,change_pct_24h:-3.4},{symbol:'SAMPLE2USDT',rule_decision:'SHORT',short_score:4,long_score:1,adx:22,price:1.083,change_pct_24h:-2.1},{symbol:'SAMPLE3USDT',rule_decision:'WAIT',short_score:2,long_score:2,adx:14,price:64.2,change_pct_24h:0.4}],
signals:[{symbol:'SAMPLE1USDT',direction:'SHORT',combined_decision:'SHORT',rule_decision:'SHORT',gemini_decision:'SHORT',entry:0.2171,stop_loss:0.22257,tp2:0.2061,risk_reward:2,disagreement:false,agreement_score:100,expires_at:new Date(now+40*6e4).toISOString()},{symbol:'SAMPLE2USDT',direction:'WAIT',combined_decision:'WAIT',rule_decision:'SHORT',gemini_decision:'WAIT',disagreement:true,agreement_score:50,expires_at:new Date(now-10*6e4).toISOString()}],
paper:{equity:1004.2,return_pct:0.42,win_rate_pct:null,closed_count:0,open_trades:[{symbol:'SAMPLE1USDT',direction:'SHORT',entry:0.2178,price:0.2169,unrealized_pnl:1.9}],warning:'Fewer than 30 closed trades: results are NOT statistically meaningful.'}};
function ico(k){return '<svg viewBox="0 0 24 24" aria-hidden="true">'+IC[k]+'</svg>'}
function pill(d){return '<span class="pill '+esc(d||'WAIT')+'">'+esc(d||'WAIT')+'</span>'}
function cand(rows,key,sc){return rows.length?rows.map(r=>'<div class="li"><div><b>'+esc(r.symbol)+'</b><small>'+sc+' '+r[key]+'/5 · ADX '+Math.round(r.adx)+' · '+fp(r.price)+' · '+(Number(r.change_pct_24h)>0?'+':'')+Number(r.change_pct_24h).toFixed(1)+'%</small></div>'+pill(r.rule_decision)+'</div>').join(''):'<p class="warn">'+t('none')+'</p>'}
function sk(){return '<div class="sk"></div><div class="sk"></div><div class="sk"></div>'}
function banner(){return (S.demo?'<div class="demo">'+t('demo')+'</div>':'')+(S.err?'<div class="err">'+t('err')+' '+esc(S.err)+'</div>':'')}
function vHome(){
 const d=S.data,live=!S.demo&&!S.err&&d;
 let h='<section class="hero"><h1>'+t('hello')+'</h1><p>'+t('sub')+'</p><div class="row"><span class="chip"><i class="dot '+(live?'on':'')+'"></i>'+(live?t('aiOn'):t('aiOff'))+'</span>';
 if(d&&d.status)h+='<span class="chip">'+t('auto')+': <b>'+(d.status.automation_enabled?t('on'):t('off'))+'</b></span><span class="chip">'+t('lastScan')+': '+ago(d.status.last_scan)+'</span>';
 h+='</div></section>'+banner();
 if(S.loading&&!d)return h+sk();
 if(!d)return h;
 const p=d.paper||{},sc=d.scan||[];
 h+='<div class="card"><h2>'+t('paper')+'</h2><div class="stats"><div class="stat"><b>'+fp(p.equity)+'</b><span>'+t('equity')+'</span></div><div class="stat"><b>'+(p.return_pct==null?'–':p.return_pct+'%')+'</b><span>'+t('ret')+'</span></div><div class="stat"><b>'+(p.win_rate_pct==null?'–':p.win_rate_pct+'%')+'</b><span>'+t('win')+' ('+(p.closed_count||0)+')</span></div></div>'+(p.warning?'<p class="warn">'+esc(p.warning)+'</p>':'')+'</div>';
 h+='<div class="g g2"><div class="card"><h2>'+t('topShort')+'</h2>'+cand(sc.filter(r=>r.rule_decision==='SHORT'),'short_score','SHORT')+'</div><div class="card"><h2>'+t('topLong')+'</h2>'+cand(sc.filter(r=>r.rule_decision==='LONG'),'long_score','LONG')+'</div></div>';
 h+='<p class="warn">'+sc.filter(r=>r.rule_decision==='WAIT').length+' '+t('waitN')+'</p>';
 const o=p.open_trades||[];
 h+='<div class="card"><h2>'+t('open')+'</h2>'+(o.length?o.map(x=>'<div class="li"><div><b>'+esc(x.symbol)+'</b><small>'+t('entry')+' '+fp(x.entry)+' · '+fp(x.price)+'</small></div><div style="text-align:right">'+pill(x.direction)+'<small style="color:'+(Number(x.unrealized_pnl)>=0?'#0B7A47':'#B4232A')+'">'+(x.unrealized_pnl==null?'–':(x.unrealized_pnl>0?'+':'')+x.unrealized_pnl)+'</small></div></div>').join(''):'<p class="warn">'+t('none')+'</p>')+'</div><p class="warn">'+t('warn')+'</p>';
 return h}
function vTrade(){
 const d=S.data;let h=banner();
 if(S.loading&&!d)return h+sk();
 const s=(d&&d.signals)||[];
 h+='<div class="card"><h2>'+t('sig')+'</h2>'+(s.length?s.map(x=>{const dec=x.combined_decision||x.direction;return '<div class="li" style="align-items:flex-start"><div><b>'+esc(x.symbol)+'</b> '+(x.disagreement?'<span class="pill tag">'+t('dis')+'</span>':'')+'<small>Rule '+esc(x.rule_decision||'–')+' · Gemini '+esc(x.gemini_decision||'–')+' · '+t('agree')+' '+(x.agreement_score==null?'–':x.agreement_score+'%')+'</small>'+(dec==='LONG'||dec==='SHORT'?'<small>'+t('entry')+' '+fp(x.entry)+' · '+t('sl')+' '+fp(x.stop_loss)+' · TP2 '+fp(x.tp2)+' · R:R '+(x.risk_reward||'–')+'</small>':'')+'<small>'+t('exp')+': '+ago2(x.expires_at)+'</small></div>'+pill(dec)+'</div>'}).join(''):'<p class="warn">'+t('none')+'</p>')+'</div><p class="warn">'+t('warn')+'</p>';
 return h}
function vChat(){
 const m=S.chat.map(x=>'<div class="b '+x.r+'">'+esc(x.m)+'</div>').join('')+(S.typing?'<div class="b a ty"><span></span><span></span><span></span></div>':'');
 const rec=S.chat.filter(x=>x.r==='u').slice(-4).reverse();
 return '<div class="card"><h2>'+t('chat')+'</h2><div class="msgs" id="msgs">'+(m||'<p class="warn">'+t('needChat')+'</p>')+'</div><div class="inp"><input type="text" id="msg" placeholder="'+esc(t('ph'))+'" onkeydown="if(event.key===\'Enter\')send()"><button class="btn" onclick="send()">'+t('send')+'</button></div>'+
 '<div class="q"><span class="warn" style="margin:0;align-self:center">'+t('quick')+':</span>'+['q1','q2','q3'].map(k=>'<button onclick="ask(\''+k+'\')">'+t(k)+'</button>').join('')+'</div></div>'+
 (rec.length?'<div class="card"><h2>'+t('recent')+'</h2>'+rec.map(x=>'<div class="li"><span>'+esc(x.m.slice(0,70))+'</span></div>').join('')+'</div>':'')}
function vTools(){
 const L=[['tTrade','trade','live'],['tChat','chat','needs'],['tSmart','chat','needs'],['tCode','tools','needs'],['tImg','tools','nb'],['tDoc','tools','nb']];
 return '<div class="card"><h2>'+t('tl')+'</h2>'+L.map(x=>'<div class="li"><div class="tool"><i>'+ico(x[1])+'</i><b>'+t(x[0])+'</b></div><span class="st '+x[2]+'">'+t(x[2]==='nb'?'nb':x[2])+'</span></div>').join('')+'</div>'}
function vSet(){
 const c=S.cfg;
 return '<div class="card"><h2>'+t('settings')+'</h2><label>'+t('url')+'</label><input type="url" id="cu" placeholder="https://xxxx.supabase.co" value="'+esc(c.url||'')+'"><label>'+t('anon')+'</label><input type="password" id="ca" value="'+esc(c.anon||'')+'"><label>'+t('pin')+'</label><input type="password" id="cp" value="'+esc(c.pin||'')+'"><label style="display:flex;gap:10px;align-items:center;color:var(--ink)"><input type="checkbox" id="cc" '+(c.chatOn?'checked':'')+' style="width:22px;height:22px"> '+t('chatOn')+'</label><div class="row"><button class="btn" onclick="saveCfg()">'+t('save')+'</button><button class="btn o" onclick="saveCfg(true)">'+t('test')+'</button></div><p class="warn" id="cs"></p></div>'}
function render(){
 $('#tag').textContent=t('tag');document.documentElement.lang=S.lang;
 $('#nav').innerHTML=['home','trade','chat','tools','settings'].map(k=>'<button class="'+(S.tab===k?'a':'')+'" onclick="go(\''+k+'\')">'+ico(k)+'<span>'+t(k)+'</span></button>').join('');
 const V={home:vHome,trade:vTrade,chat:vChat,tools:vTools,settings:vSet};
 $('#app').innerHTML=V[S.tab]();
 const m=$('#msgs');if(m)m.scrollTop=m.scrollHeight}
function go(k){S.tab=k;render();window.scrollTo(0,0)}
async function load(){
 const c=S.cfg;
 if(!c.url||!c.anon||!c.pin){S.data=DEMO;S.demo=true;S.err=null;S.loading=false;render();return}
 S.demo=false;
 try{const r=await fetch(c.url.replace(/\/$/,'')+'/functions/v1/dashboard-data',{method:'POST',headers:{'Content-Type':'application/json',apikey:c.anon,Authorization:'Bearer '+c.anon,'x-dashboard-pin':c.pin},body:JSON.stringify({interval:'15m'})});
  const j=await r.json();if(!r.ok||!j.ok)throw new Error(j.error||j.message||('HTTP '+r.status));S.data=j;S.err=null}
 catch(e){S.err=String(e.message||e)}
 S.loading=false;render()}
function saveCfg(test){
 S.cfg={url:$('#cu').value.trim(),anon:$('#ca').value.trim(),pin:$('#cp').value,chatOn:$('#cc').checked};sv('cfg',S.cfg);
 $('#cs').textContent=t('saved');
 if(test){S.loading=true;load().then(()=>{$('#cs').textContent=S.err?(t('err')+' '+S.err):t('ok')})}
 else load()}
function ask(k){$('#msg').value=t(k);send()}
async function send(){
 const i=$('#msg');const m=i.value.trim();if(!m)return;
 S.chat.push({r:'u',m});S.typing=true;render();
 const c=S.cfg;let reply;
 if(c.chatOn&&c.url&&c.anon&&c.pin){
  try{const r=await fetch(c.url.replace(/\/$/,'')+'/functions/v1/ai-chat',{method:'POST',headers:{'Content-Type':'application/json',apikey:c.anon,Authorization:'Bearer '+c.anon,'x-dashboard-pin':c.pin},body:JSON.stringify({message:m,lang:S.lang})});
   const j=await r.json();reply=j.reply||j.error||j.message||'No reply'}
  catch(e){reply=t('err')+' '+e.message}
 }else reply=t('needChat');
 S.typing=false;S.chat.push({r:'a',m:reply});sv('chat',S.chat.slice(-40));render()}
render();load();
setInterval(()=>{if(!S.demo&&(S.tab==='home'||S.tab==='trade'))load()},60000);
</script>
